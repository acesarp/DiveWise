{
	"folders": [
		{
			"path": "."
		}
	],
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "🐍 Python: Streamlit (app.py)",
				"type": "debugpy",
				"request": "launch",
				"module": "streamlit",
				"cwd": "${workspaceFolder}",
				"console": "integratedTerminal",
				"args": [
					"run",
					"app.py",
					"--server.port",
					"8084",
					"--logger.level=debug",
					"--server.address",
					"127.0.0.1"
				],
				"env": {
					"PYTHONUNBUFFERED": "1"
				},
				"justMyCode": true,
				"jinja": true
			}
		]
	}
}